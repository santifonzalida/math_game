server {
  # Railway (and most PaaS) assign the port through $PORT; defaults to 80 in the Dockerfile.
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Hashed bundles (main-XXXX.js, styles-XXXX.css) never change: cache them for a year.
  location ~* \.(?:js|css)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Generated at container start from API_URL (see 40-env-js.sh): must never be cached.
  location = /env.js {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  # SPA fallback: /play, /ranking, etc. are Angular routes, not files.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
